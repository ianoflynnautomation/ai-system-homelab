---
# Copy to secret.sops.yaml, fill in the real values, then encrypt in place:
#
#   sops --encrypt --in-place secret.sops.yaml
#
# .sops.yaml restricts encryption to the `data`/`stringData` keys, so the
# structure stays readable in Git and only the values are ciphertext.
# The unencrypted file must never be committed — see gitops/README.md.
apiVersion: v1
kind: Secret
metadata:
  name: github-runner-auth
  namespace: arc-runners
type: Opaque
stringData:
  # --- GitHub App (recommended) ---
  # ARC requires the installation id explicitly; it does not auto-discover.
  # Find it at https://github.com/settings/installations/<THIS_NUMBER>
  github_app_id: "123456"
  github_app_installation_id: "12345678"
  github_app_private_key: |
    -----BEGIN RSA PRIVATE KEY-----
    ...paste the .pem contents here, indented...
    -----END RSA PRIVATE KEY-----

  # --- PAT alternative: delete the three keys above and use this instead ---
  # github_token: "github_pat_..."
